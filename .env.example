# ==============================================================================
# RevGuard Environment Configuration
# ==============================================================================
# Copy this file to '.env' in the project root:
#   copy .env.example .env
#
# Note:
# - The Backend loads environment variables from the root '.env' file.
# - The Frontend (Vite) only needs 'frontend/.env' with VITE_API_URL=http://localhost:8000.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Razorpay Configuration (Test Mode)
# ------------------------------------------------------------------------------
# Get your API keys at: https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook Secret configured in: Razorpay Dashboard -> Settings -> Webhooks
# Needed to verify incoming webhooks for 'payment_link.paid'
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# 2. Google Gemini API
# ------------------------------------------------------------------------------
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 3. Firebase / Google Cloud Firestore
# ------------------------------------------------------------------------------
# Firebase Project ID from: Firebase Console -> Project Settings -> General
FIRESTORE_PROJECT_ID=your-firebase-project-id

# Path to the downloaded Firebase service account private key JSON file
# Generate at: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=d:/RazorPayHackathon/serviceaccount.json

# ------------------------------------------------------------------------------
# 4. Customer Messaging Configuration
# ------------------------------------------------------------------------------
# Options: 'mock' (default, stores messages to Firestore) or 'twilio'
MESSAGING_PROVIDER=mock

# Twilio Credentials (Required ONLY if MESSAGING_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. RevGuard Policy Engine Thresholds
# ------------------------------------------------------------------------------
# Max amount permitted for AUTO recovery without human review (in paise, integer)
# 1,000,000 paise = Rs.10,000
POLICY_MAX_AMOUNT_AUTO=1000000

# Minimum AI diagnosis confidence required for AUTO recovery (0.0 to 1.0)
POLICY_MIN_CONFIDENCE_AUTO=0.85

# Maximum retry attempts before forcing case to QUEUE_FOR_REVIEW
POLICY_MAX_RETRY_AUTO=3

# ------------------------------------------------------------------------------
# 6. Application & Server Settings
# ------------------------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
